<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package (MSIX) for Island For Windows. tools/make_msix.ps1 fills in
  the $...$ values, adds Island.exe, the images and resources.pri, and packs it.
  The Store signs the package after review, so the upload is unsigned.

  Identity Name, Publisher and PublisherDisplayName must be the values on
  Partner Center > Oyenza Studio > Product identity, or the Store refuses the upload.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Island For Windows</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <!-- The MSVC build loads vcruntime140.dll; the Store installs this framework with the app. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" MinVersion="14.0.24217.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Poni" Executable="Island.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Island For Windows"
        Description="Island For Windows：同步歌词、日历与待办、专注计时、文件暂存和系统监控。"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- "Start with Windows". TaskId must match TASK_ID in crates/poni/src/autostart.rs. -->
        <uap5:Extension Category="windows.startupTask" Executable="Island.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="PoniStartup" Enabled="true" DisplayName="Island For Windows" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Lyrics lookups (LRCLIB, and Apple Music once the user adds a token). -->
    <Capability Name="internetClient" />
    <!-- Notifications (on by default in this copy, off under Tabs in Settings): other apps'
         notifications on the island, read on the PC and never sent anywhere. Windows asks the
         person before it allows it. -->
    <uap3:Capability Name="userNotificationListener" />
    <!-- A desktop app: runs outside the app sandbox, like the installer build. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Headphone battery levels over Bluetooth LE. -->
    <DeviceCapability Name="bluetooth" />
    <!-- Prayer times (an add-on, off by default) asks Windows where the PC is, to pick the nearest place. -->
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
